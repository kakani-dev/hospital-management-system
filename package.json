{
  "name": "hospital-management-system",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant Hospital Management System. Synthetic data only.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "web:install": "npm --prefix apps/web ci",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:lint": "npm --prefix apps/web run lint",
    "web:test": "npm --prefix apps/web run test",
    "e2e": "playwright test -c tests/playwright/playwright.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "sql:test": "bash supabase/scripts/run-sql-tests.sh",
    "api:build": "dotnet build backend/Hms.slnx",
    "api:test": "dotnet test backend/Hms.slnx --filter Category!=Database",
    "verify": "bash scripts/verify.sh",
    "prepare": "lefthook install",
    "clean": "bash scripts/clean.sh",
    "clean:all": "bash scripts/clean.sh --all",
    "e2e:db": "SKIP_SQL_TESTS=1 TEST_DB=${E2E_DB:-hms_e2e} bash supabase/scripts/run-sql-tests.sh",
    "mock-auth": "node tests/mock-auth/server.mjs",
    "api:test:db": "dotnet test backend/Hms.slnx --filter Category=Database",
    "e2e:mocked": "playwright test -c tests/playwright/playwright.mocked.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "jose": "^6.2.12",
    "lefthook": "^1.13.6",
    "pg": "^8.23.1"
  }
}

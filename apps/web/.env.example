# Copy to apps/web/.env.local (git-ignored). Placeholders only — never commit real values.

# Base URL of the ASP.NET Core gateway. Leave empty to use same-origin (/api via Vite proxy in dev).
VITE_API_BASE_URL=

# Supabase Auth (browser). PUBLIC values only:
#   VITE_SUPABASE_URL              e.g. https://<project-ref>.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY  the publishable key (sb_publishable_...) — or the legacy anon key below
# NEVER put the service-role / secret key in any VITE_* variable (it would ship to every browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Idle auto-logoff (HIPAA automatic logoff), in minutes. Default 15. Activity in any HMS tab resets the timer.
VITE_IDLE_TIMEOUT_MINUTES=15

# --- Cold-start resilience (free hosting: the edge and services scale to zero) -----------------
# The edge times out upstream calls at 30 s and answers a cold/unreachable service with
# 503 service_unavailable + Retry-After: 5. Not measured yet: tune these once Phase 1 has numbers.
# Client timeout for GETs, ms (a bit above the edge's 30 s). Default 40000.
VITE_API_GET_TIMEOUT_MS=40000
# Client timeout for POST/PATCH/PUT/DELETE, ms. Writes are NEVER retried automatically: the user
# gets a Retry button. Default 40000.
VITE_API_WRITE_TIMEOUT_MS=40000
# Automatic GET retries after the first attempt, on network errors, timeouts, 502/503/504 and 429.
# 0 disables. Default 3.
VITE_API_RETRY_COUNT=3
# Backoff: base delay (ms) x factor^attempt, +/-25 % jitter, each wait capped at the max (ms).
# A server Retry-After header (seconds or HTTP date) replaces the computed delay, still capped.
# Defaults 1000 / 3 / 30000 (1 s, 3 s, 9 s).
VITE_API_RETRY_BASE_DELAY_MS=1000
VITE_API_RETRY_FACTOR=3
VITE_API_RETRY_MAX_DELAY_MS=30000
# "Waking the server..." banner after a request has been pending this long (ms). Default 4000.
VITE_WAKING_BANNER_AFTER_MS=4000
# Banner switches to "Still waking... Retry now" after this long (ms). Default 60000.
VITE_WAKING_STILL_AFTER_MS=60000

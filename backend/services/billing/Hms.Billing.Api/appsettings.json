{
  "ConnectionStrings": {
    "HmsDatabase": "Host=localhost;Port=5432;Database=hms;Username=hms_billing_login;Password=hms_billing_local_only"
  },
  "Database": {
    "MaxPoolSize": 5,
    "SessionRole": "hms_svc_billing"
  },
  "Auth": {
    "Supabase": {
      "ProjectUrl": "",
      "Audience": "authenticated",
      "LegacyJwtSecret": "",
      "AllowInsecureHttp": false
    }
  },
  "Edge": {
    "Key": ""
  },
  "Billing": {
    "WebhookSecret": "local-billing-webhook",
    "SandboxPayeeAddress": "sandbox@medicore",
    "SandboxPayeeName": "MediCore Sandbox"
  },
  "Outbox": {
    "Dispatcher": {
      "Enabled": false,
      "DryRun": true
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitPerMinute": 120
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "GlExport": {
    "Ledgers": {
      "party:self": {
        "Name": "Patient Receivables",
        "Group": "Sundry Debtors"
      },
      "party:corporate": {
        "Name": "Corporate Receivables",
        "Group": "Sundry Debtors"
      },
      "party:insurer": {
        "Name": "TPA / Insurance Receivables",
        "Group": "Sundry Debtors"
      },
      "sales:*": {
        "Name": "{category} Income",
        "Group": "Sales Accounts"
      },
      "gst:cgst": {
        "Name": "Output CGST @ {rate}%",
        "Group": "Duties & Taxes"
      },
      "gst:sgst": {
        "Name": "Output SGST @ {rate}%",
        "Group": "Duties & Taxes"
      },
      "gst:igst": {
        "Name": "Output IGST @ {rate}%",
        "Group": "Duties & Taxes"
      },
      "discount": {
        "Name": "Discount Allowed",
        "Group": "Indirect Expenses"
      },
      "round_off": {
        "Name": "Round Off",
        "Group": "Indirect Expenses"
      },
      "tender:cash": {
        "Name": "Cash",
        "Group": "Cash-in-Hand"
      },
      "tender:card": {
        "Name": "Card Settlement Account",
        "Group": "Bank Accounts"
      },
      "tender:upi": {
        "Name": "UPI Collections",
        "Group": "Bank Accounts"
      },
      "tender:bank": {
        "Name": "Bank Transfers",
        "Group": "Bank Accounts"
      },
      "tender:credit": {
        "Name": "Corporate Receivables",
        "Group": "Sundry Debtors"
      }
    },
    "VoucherTypes": {
      "sales": "Sales",
      "credit_note": "Credit Note",
      "receipt": "Receipt",
      "refund": "Payment",
      "journal": "Journal"
    }
  }
}

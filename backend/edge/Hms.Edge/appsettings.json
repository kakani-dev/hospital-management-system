{
  "Auth": {
    "Supabase": {
      "ProjectUrl": "",
      "Audience": "authenticated",
      "LegacyJwtSecret": "",
      "AllowInsecureHttp": false
    }
  },
  "Edge": {
    "Key": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://medicore-hms-three.vercel.app",
      "http://localhost:5173",
      "http://localhost:4173"
    ],
    "AllowedOriginPatterns": [
      "https://medicore-hms-[a-z0-9-]+-kakani-devs-projects\\.vercel\\.app"
    ],
    "PreflightMaxAgeSeconds": 600
  },
  "RateLimiting": {
    "PermitPerMinute": 300,
    "WarmupPerMinute": 10
  },
  "ReverseProxy": {
    "Routes": {
      "identity-me": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/me/{**rest}"
        }
      },
      "identity-tenants": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/tenants/{**rest}"
        }
      },
      "identity-branches": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/branches/{**rest}"
        }
      },
      "identity-platform": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/platform/{**rest}"
        }
      },
      "identity-public": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/public/{**rest}"
        }
      },
      "identity-members": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/members/{**rest}"
        }
      },
      "patients-patients": {
        "ClusterId": "patients",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/patients/{**rest}"
        }
      },
      "scheduling-practitioners": {
        "ClusterId": "scheduling",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/practitioners/{**rest}"
        }
      },
      "scheduling-schedules": {
        "ClusterId": "scheduling",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/schedules/{**rest}"
        }
      },
      "scheduling-practitioner-branches": {
        "ClusterId": "scheduling",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/practitioner-branches/{**rest}"
        }
      },
      "scheduling-schedule-overrides": {
        "ClusterId": "scheduling",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/schedule-overrides/{**rest}"
        }
      },
      "scheduling-settings": {
        "ClusterId": "scheduling",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/scheduling-settings/{**rest}"
        }
      },
      "scheduling-slots": {
        "ClusterId": "scheduling",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/slots/{**rest}"
        }
      },
      "scheduling-appointments": {
        "ClusterId": "scheduling",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/appointments/{**rest}"
        }
      },
      "scheduling-queue": {
        "ClusterId": "scheduling",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/queue/{**rest}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8101/"
          }
        }
      },
      "patients": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8102/"
          }
        }
      },
      "scheduling": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8103/"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}